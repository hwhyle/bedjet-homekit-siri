# Copy to .env and fill in (or export these in your shell).
# Never commit .env or a live token.

# Your Home Assistant URL, including the port if it is not 80/443.
# HA OS typically serves the UI and API on port 8123 over HTTP on the LAN.
HA_URL=http://homeassistant.local:8123

# A long-lived access token created in Home Assistant:
#   Profile (your initials, lower-left) -> Security -> Long-Lived Access Tokens
HA_TOKEN=
