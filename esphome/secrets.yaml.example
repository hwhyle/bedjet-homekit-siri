# Copy this file to secrets.yaml and fill in your values.
# secrets.yaml is gitignored and must never be committed.

# Your Wi-Fi network
wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Generate an API encryption key:
#   openssl rand -base64 32
api_encryption_key: "paste-the-openssl-output-here"

# Pick a unique password used when pushing OTA firmware updates
ota_password: "choose-a-unique-ota-password"

# Password for the fallback access point if Wi-Fi is unavailable (8+ characters)
fallback_ap_password: "choose-a-fallback-ap-password"
